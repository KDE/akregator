> <guimenuitem
>افتح في متصفح خارجي.</guimenuitem
> </menuchoice
></term>
<listitem
><para
><action
>افتح</action
> المقال الحالي في متصفح خارجي</para
></listitem>
</varlistentry>
<varlistentry>
<term
><menuchoice
><shortcut
><keycombo action="simul"
>&Ctrl;<keycap
>I</keycap
></keycombo
></shortcut
> <guimenu
>مقال</guimenu
> <guimenuitem
>ميّز كمهم</guimenuitem
> </menuchoice
></term>
<listitem
><para
><action
>ميّز</action
> المقال الحالي كمهم</para
></listitem>
</varlistentry>
<varlistentry>
<term
><menuchoice
><guimenu
>مقال</guimenu
> <guimenuitem
>ميّز كـ</guimenuitem
> </menuchoice
></term>
