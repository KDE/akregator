><menuchoice
><shortcut
><keycombo action="simul"
>&Shift;<keycap
>Return</keycap
></keycombo
></shortcut
> <guimenu
>مقال</guimenu
> <guimenuitem
>افتح في لسان</guimenuitem
> </menuchoice
></term>
<listitem
><para
